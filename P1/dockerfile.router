FROM alpine:3.19

# Install FRR + base tools (all in one layer, no apt mess)
RUN apk add --no-cache \
    frr \
    busybox \
    iproute2 \
    iputils \
    bash

# Enable required daemons
RUN sed -i \
    -e 's/^zebra=no/zebra=yes/' \
    -e 's/^bgpd=no/bgpd=yes/' \
    -e 's/^ospfd=no/ospfd=yes/' \
    -e 's/^isisd=no/isisd=yes/' \
    /etc/frr/daemons

# Prepare config directory
RUN mkdir -p /etc/frr \
    && touch /etc/frr/zebra.conf \
    && touch /etc/frr/bgpd.conf \
    && touch /etc/frr/ospfd.conf \
    && touch /etc/frr/isisd.conf \
    && chown -R frr:frr /etc/frr

# Copy configs and startup script
COPY configs/ /etc/frr/
RUN chown -R frr:frr /etc/frr

COPY --chown=root:root start-frr.sh /usr/local/bin/start-frr.sh
RUN chmod +x /usr/local/bin/start-frr.sh

WORKDIR /root

CMD ["/usr/local/bin/start-frr.sh"]
