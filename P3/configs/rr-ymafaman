# RR-ymafaman network configuration 
# Interface eth0 is connected to VTEP-ymafaman-1 (eth0)
# Interface eth1 is connected to VTEP-ymafaman-2 (eth1)
# Interface eth2 is connected to VTEP-ymafaman-3 (eth2) 
# lo : IP: 1.1.1.1
# eth0 : IP: 10.0.12.1/30
# eth1 : IP: 10.0.13.1/30
# eth2 : IP: 10.0.14.1/30

auto lo
iface lo inet static
	address 1.1.1.1
	netmask 255.255.255.255

auto eth0
iface eth0 inet static
	address 10.0.12.1
	netmask 255.255.255.252

auto eth1
iface eth1 inet static
	address 10.0.13.1
	netmask 255.255.255.252

auto eth2
iface eth2 inet static
	address 10.0.14.1
	netmask 255.255.255.252

