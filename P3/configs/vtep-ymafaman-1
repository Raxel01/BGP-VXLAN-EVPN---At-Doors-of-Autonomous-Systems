# VTEP-1 network configuration 
# Interface eth0 is connected to rr-ymafaman (eth0)
# Interface eth1 is connected to host-ymafaman-1 (eth1) 
# lo : IP: 2.2.2.2
# eth0 : IP: 10.0.12.2/30

auto lo
iface lo inet static
	address 2.2.2.2
	netmask 255.255.255.255

auto eth0
iface eth0 inet static
	address 10.0.12.2
	netmask 255.255.255.252
	up /sbin/ip link add br0 type bridge
	up /sbin/ip link set br0 up
	up /sbin/ip link set eth1 master br0
	up /sbin/ip link set eth1 up
	up /sbin/ip link add vxlan10 type vxlan id 10 local 2.2.2.2 dstport 4789 nolearning
	up /sbin/ip link set vxlan10 master br0
	up /sbin/ip link set vxlan10 up

