# VTEP-2 network configuration 
# Interface eth0 is connected to host-ymafaman-2 (eth0) 
# Interface eth1 is connected to rr-ymafaman (eth1)
# lo : IP: 3.3.3.3
# eth1 : IP: 10.0.13.2/30

auto lo
iface lo inet static
	address 3.3.3.3
	netmask 255.255.255.255

auto eth1
iface eth1 inet static
	address 10.0.13.2
	netmask 255.255.255.252
	up /sbin/ip link add br0 type bridge
	up /sbin/ip link set br0 up
	up /sbin/ip link set eth0 master br0
	up /sbin/ip link set eth0 up
	up /sbin/ip link add vxlan10 type vxlan id 10 local 3.3.3.3 dstport 4789 nolearning
	up /sbin/ip link set vxlan10 master br0
	up /sbin/ip link set vxlan10 up
