# VTEP-3 network configuration 
# Interface eth0 is connected to host-ymafaman-3 (eth0) 
# Interface eth2 is connected to rr-ymafaman (eth2)
# lo : IP: 4.4.4.4
# eth2 : IP: 10.0.14.2/30

auto lo
iface lo inet static
	address 4.4.4.4
	netmask 255.255.255.255

auto eth2
iface eth2 inet static
	address 10.0.14.2
	netmask 255.255.255.252
	up /sbin/ip link add br0 type bridge
	up /sbin/ip link set br0 up
	up /sbin/ip link set eth0 master br0
	up /sbin/ip link set eth0 up
	up /sbin/ip link add vxlan10 type vxlan id 10 local 4.4.4.4 dstport 4789 nolearning
	up /sbin/ip link set vxlan10 master br0
	up /sbin/ip link set vxlan10 up

